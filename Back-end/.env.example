# ==========================================
# 1. SERVER & JWT CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=development
JWT_SECRET="posenova_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# ==========================================
# 2. SUPABASE POSTGRESQL (PRISMA ORM)
# ==========================================
# Transaction Pooler (Port 6543) — Dùng cho Prisma Client query trong ứng dụng
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15&keepalives=1&keepalives_idle=30"

# Session Pooler / Direct Connection (Port 5432) — Dùng cho Prisma Migrate (npx prisma migrate dev)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Optional Supabase API Keys
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ==========================================
# 3. GOOGLE GEMINI AI CO-PILOT
# ==========================================
GEMINI_API_KEY="your_gemini_api_key_here"

# ==========================================
# 4. SEPAY VIETQR ESCROW GATEWAY
# ==========================================
SEPAY_WEBHOOK_SECRET="sepay_posenova_webhook_secret_2026"
SEPAY_BANK_CODE="MBBank"
SEPAY_ACCOUNT_NO="0987654321"
SEPAY_ACCOUNT_NAME="POSENOVA ESCROW SYSTEM"

