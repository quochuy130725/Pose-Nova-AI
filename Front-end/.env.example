# ==========================================
# PoseNova AI Front-End Environment Config (.env.example)
# ==========================================

# Standard Back-End API Base URL (Desktop Windows / macOS / iOS / Web / ADB Reverse)
API_BASE_URL=http://localhost:3000/api/v1

# Android Emulator Host Loopback Base URL (Maps 10.0.2.2 to host machine's 127.0.0.1)
API_BASE_URL_ANDROID=http://10.0.2.2:3000/api/v1

# Network Request Timeout in seconds
API_TIMEOUT_SECONDS=8


# Enable resilient offline fallback when backend is unreachable
ENABLE_OFFLINE_FALLBACK=true

